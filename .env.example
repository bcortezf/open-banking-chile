# -------------- Banco Falabella --------------
# Tu RUT sin puntos ni guión (ej: 123456789)
FALABELLA_RUT=123456789
# Tu clave de internet del banco
FALABELLA_PASS=tu_clave_aqui
# Opcional: filtro TC por titular/adicional (T=titular, A=adicional, B=todos, default: B)
# FALABELLA_OWNER=B

# -------------- Banco BICE --------------
BICE_RUT=123456789
BICE_PASS=tu_clave_aqui
# Opcional: cantidad de periodos históricos adicionales a consultar (default: 0 = solo mes actual, entre 1-16)
# BICE_MONTHS=3

# -------------- Banco Santander --------------
SANTANDER_RUT=123456789
SANTANDER_PASS=tu_clave_aqui
# Opcional: segundos máximos para esperar aprobación manual de 2FA (default: 180)
# SANTANDER_2FA_TIMEOUT_SEC=240

# -------------- Banco Edwards --------------
EDWARDS_RUT=123456789
EDWARDS_PASS=tu_clave_aqui

# -------------- Banco BCI --------------
BCI_RUT=123456789
BCI_PASS=tu_clave_aqui
# Opcional: segundos máximos para esperar aprobación manual de 2FA (default: 180)
# BCI_2FA_TIMEOUT_SEC=240

# -------------- Banco Itaú --------------
ITAU_RUT=123456789
ITAU_PASS=tu_clave_aqui
# Opcional: segundos máximos para esperar aprobación manual de 2FA Itaú Key (default: 180)
# ITAU_2FA_TIMEOUT_SEC=240

# -------------- Banco de Chile (personas y empresas) --------------
BCHILE_RUT=123456789
BCHILE_PASS=tu_clave_aqui
# Opcional: segundos máximos para esperar aprobación manual de 2FA (default: 180)
# BCHILE_2FA_TIMEOUT_SEC=240
# Empresas: usar --empresa y opcionalmente --bankQuery=<RUT> para consultar cuenta empresa

# -------------- Banco Scotiabank --------------
SCOTIABANK_RUT=123456789
SCOTIABANK_PASS=tu_clave_aqui
# Opcional:
# SCOTIABANK_MONTHS=3
# SCOTIABANK_2FA_TIMEOUT_SEC=240
# Empresas: --scope business:RUT_EMPRESA  (SCOTIABANK_RUT = RUT usuario)
# Alternativa: SCOTIABANK_EMPRESA_RUT=76123456-0
# SCOTIABANK_EMPRESA_RUT=
# -------------- Banco Estado --------------
BESTADO_RUT=123456789
BESTADO_PASS=tu_clave_aqui

# -------------- Otras configs --------------
# Opcional: ruta al ejecutable de Chrome/Chromium
# CHROME_PATH=/usr/bin/google-chrome-stable
